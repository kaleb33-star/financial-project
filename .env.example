# Copy this file to ".env" and fill in real values before running the app.

# Password for the admin login (change this!)
ADMIN_PASSWORD=change-me-admin

# Password for the shared staff/data-entry login (change this!)
USER_PASSWORD=change-me-staff

# A long random string used to sign login-session cookies.
# Any random text works — e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# Set to "true" once your site is served over https:// (recommended)
COOKIE_SECURE=false
